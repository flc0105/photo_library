.env
.env.*
!.env.example
.gallery_auth_secret
.gallery_session_secret
.photo_library_auth_secret
.photo_library_session_secret

# Runtime storage generated by the app
/storage/

# Historical/runtime cache locations
/library_cache/
/compressed/
/thumbnails/
/uploads/

